def format_number(value):

    if not math.isfinite(value):
        return "∞"

    if abs(value) < 1e-12:
        value = 0

    if abs(value) >= 1e12 or (
        abs(value) < 1e-9
        and value != 0
    ):
        return f"{value:.8e}"

    if float(value).is_integer():
        return f"{int(value):,}".replace(
            ",",
            ".",
        )

    text = (
        f"{value:.12f}"
        .rstrip("0")
        .rstrip(".")
    )

    if "." in text:

        integer, decimal = text.split(".")

        sign = ""

        if integer.startswith("-"):
            sign = "-"
            integer = integer[1:]

        integer = f"{int(integer):,}".replace(
            ",",
            ".",
        )

        return (
            f"{sign}{integer},{decimal}"
        )

    return text


