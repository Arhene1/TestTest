# SAFE CALCULATOR
# ============================================================

def factorial(value):
    if not math.isfinite(value):
        raise ValueError("Ungültige Zahl")

    if value < 0 or value != int(value):
        raise ValueError(
            "Fakultät benötigt eine positive Ganzzahl"
        )

    if value > 170:
        raise OverflowError(
            "Zahl ist für Fakultät zu groß"
        )

    return float(math.factorial(int(value)))


class SafeEvaluator:

    binary_operators = {
        ast.Add: operator.add,
        ast.Sub: operator.sub,
        ast.Mult: operator.mul,
        ast.Div: operator.truediv,
        ast.Pow: operator.pow,
        ast.Mod: operator.mod,
        ast.FloorDiv: operator.floordiv,
    }

    unary_operators = {
        ast.UAdd: operator.pos,
        ast.USub: operator.neg,
    }

    def __init__(self, angle_mode="DEG"):
        self.angle_mode = angle_mode

    def sin(self, x):
        return (
            math.sin(math.radians(x))
            if self.angle_mode == "DEG"
            else math.sin(x)
        )

    def cos(self, x):
        return (
            math.cos(math.radians(x))
            if self.angle_mode == "DEG"
            else math.cos(x)
        )

    def tan(self, x):
        return (
            math.tan(math.radians(x))
            if self.angle_mode == "DEG"
            else math.tan(x)
        )

    def asin(self, x):
        value = math.asin(x)

        return (
            math.degrees(value)
            if self.angle_mode == "DEG"
            else value
        )

    def acos(self, x):
        value = math.acos(x)

        return (
            math.degrees(value)
            if self.angle_mode == "DEG"
            else value
        )

    def atan(self, x):
        value = math.atan(x)

        return (
            math.degrees(value)
            if self.angle_mode == "DEG"
            else value
        )

    def functions(self):

        return {
            "sin": self.sin,
            "cos": self.cos,
            "tan": self.tan,
            "asin": self.asin,
            "acos": self.acos,
            "atan": self.atan,
            "sqrt": math.sqrt,
            "log": math.log10,
            "ln": math.log,
            "exp": math.exp,
            "abs": abs,
            "factorial": factorial,
        }

    def constants(self):

        return {
            "pi": math.pi,
            "e": math.e,
        }

    @staticmethod
    def normalize(expression):

        expression = expression.strip()

        replacements = {
            "×": "*",
            "÷": "/",
            "−": "-",
            "π": "pi",
            "√": "sqrt",
            "^": "**",
            "²": "**2",
            "³": "**3",
        }

        for old, new in replacements.items():
            expression = expression.replace(
                old,
                new,
            )

        expression = re.sub(
            r"(?<=\d),(?=\d)",
            ".",
            expression,
        )

        expression = re.sub(
            r"(\d+(?:\.\d+)?)%",
            r"(\1/100)",
            expression,
        )

        expression = re.sub(
            r"(\([^()]+\)|\d+(?:\.\d+)?)!",
            r"factorial(\1)",
            expression,
        )

        expression = re.sub(
            r"(\d|\))(?=(pi|e|sqrt|sin|cos|tan|asin|acos|atan|log|ln|abs|factorial)\b)",
            r"\1*",
            expression,
        )

        expression = re.sub(
            r"(\d|\))(?=\()",
            r"\1*",
            expression,
        )

        return expression

    def evaluate(self, expression):

        expression = self.normalize(
            expression
        )

        if not expression:
            raise ValueError(
                "Kein Ausdruck eingegeben"
            )

        if len(expression) > 600:
            raise ValueError(
                "Ausdruck ist zu lang"
            )

        try:
            tree = ast.parse(
                expression,
                mode="eval",
            )
        except SyntaxError:
            raise ValueError(
                "Ungültiger Ausdruck"
            )

        result = self.visit(
            tree.body
        )

        if not math.isfinite(result):
            raise OverflowError(
                "Ergebnis ist zu groß"
            )

        return float(result)

    def visit(self, node):

        if isinstance(
            node,
            ast.Constant,
        ):

            if isinstance(
                node.value,
                bool,
            ):
                raise ValueError(
                    "Ungültiger Wert"
                )

            if isinstance(
                node.value,
                (int, float),
            ):
                return float(
                    node.value
                )

            raise ValueError(
                "Ungültiger Wert"
            )

        if isinstance(
            node,
            ast.BinOp,
        ):

            operation = self.binary_operators.get(
                type(node.op)
            )

            if operation is None:
                raise ValueError(
                    "Operator nicht erlaubt"
                )

            left = self.visit(
                node.left
            )

            right = self.visit(
                node.right
            )

            try:
                return float(
                    operation(
                        left,
                        right,
                    )
                )

            except ZeroDivisionError:
                raise ZeroDivisionError(
                    "Division durch 0"
                )

            except OverflowError:
                raise OverflowError(
                    "Ergebnis ist zu groß"
                )

            except ValueError:
                raise ValueError(
                    "Ungültige Operation"
                )

        if isinstance(
            node,
            ast.UnaryOp,
        ):

            operation = self.unary_operators.get(
                type(node.op)
            )

            if operation is None:
                raise ValueError(
                    "Operator nicht erlaubt"
                )

            return float(
                operation(
                    self.visit(
                        node.operand
                    )
                )
            )

        if isinstance(
            node,
            ast.Name,
        ):

            constants = self.constants()

            if node.id in constants:
                return constants[
                    node.id
                ]

            raise ValueError(
                "Unbekannte Variable"
            )

        if isinstance(
            node,
            ast.Call,
        ):

            if not isinstance(
                node.func,
                ast.Name,
            ):
                raise ValueError(
                    "Funktion nicht erlaubt"
                )

            function = self.functions().get(
                node.func.id
            )

            if function is None:
                raise ValueError(
                    "Funktion nicht erlaubt"
                )

            if len(node.args) != 1:
                raise ValueError(
                    "Funktion benötigt ein Argument"
                )

            if node.keywords:
                raise ValueError(
                    "Argumente nicht erlaubt"
                )

            value = self.visit(
                node.args[0]
            )

            try:
                return float(
                    function(value)
                )

            except ValueError as exc:
                raise ValueError(
                    str(exc)
                )

            except ZeroDivisionError:
                raise ZeroDivisionError(
                    "Ungültige Division"
                )

            except OverflowError:
                raise OverflowError(
                    "Ergebnis ist zu groß"
                )

        raise ValueError(
            "Ausdruck enthält nicht erlaubte Elemente"
        )


