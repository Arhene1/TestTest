def add_text(value):

    if st.session_state.error:
        st.session_state.expression = ""
        st.session_state.error = ""

    st.session_state.expression += value


def clear_all():

    st.session_state.expression = ""
    st.session_state.result = ""
    st.session_state.error = ""
    st.session_state.status = "Bereit"


def clear_entry():

    st.session_state.expression = ""
    st.session_state.error = ""


def backspace():

    if st.session_state.error:
        clear_all()
        return

    st.session_state.expression = (
        st.session_state.expression[:-1]
    )


def calculate():

    expression = (
        st.session_state.expression
    )

    if not expression:
        return

    evaluator.angle_mode = (
        st.session_state.angle_mode
    )

    try:

        value = evaluator.evaluate(
            expression
        )

        result = format_number(
            value
        )

        st.session_state.result = result
        st.session_state.error = ""

        st.session_state.history.insert(
            0,
            {
                "expression": expression,
                "result": result,
            },
        )

        st.session_state.status = (
            "Berechnung erfolgreich"
        )

        st.session_state.expression = str(
            value
        )

    except Exception as exc:

        st.session_state.error = str(
            exc
        )

        st.session_state.result = ""
        st.session_state.status = (
            f"Fehler: {exc}"
        )


def toggle_sign():

    expression = (
        st.session_state.expression
    )

    if not expression:
        st.session_state.expression = "-"
        return

    if (
        expression.startswith("-(")
        and expression.endswith(")")
    ):

        st.session_state.expression = (
            expression[2:-1]
        )

    else:

        st.session_state.expression = (
            f"-({expression})"
        )


def toggle_angle():

    st.session_state.angle_mode = (
        "RAD"
        if st.session_state.angle_mode
        == "DEG"
        else "DEG"
    )

    evaluator.angle_mode = (
        st.session_state.angle_mode
    )


def memory_add():

    try:

        value = get_current_value()

        st.session_state.memory += value

        st.session_state.status = (
            "M+ gespeichert"
        )

    except Exception:

        st.session_state.error = (
            "Kein gültiger Wert"
        )


def memory_subtract():

    try:

        value = get_current_value()

        st.session_state.memory -= value

        st.session_state.status = (
            "M− gespeichert"
        )

    except Exception:

        st.session_state.error = (
            "Kein gültiger Wert"
        )


def memory_recall():

    st.session_state.expression += str(
        st.session_state.memory
    )


def memory_clear():

    st.session_state.memory = 0.0

    st.session_state.status = (
        "Speicher gelöscht"
    )


def get_current_value():

    if st.session_state.expression:

        evaluator.angle_mode = (
            st.session_state.angle_mode
        )

        return evaluator.evaluate(
            st.session_state.expression
        )

    if st.session_state.result:

        clean = (
            st.session_state.result
            .replace(".", "")
            .replace(",", ".")
        )

        return float(clean)

    return 0.0


