        ],
        [
            ("0", "0"),
            (",", ","),
            (".", "."),
            (")", ")"),
            ("+", "+"),
        ],
        [
            ("M+", "mplus"),
            ("M−", "mminus"),
            ("COPY", "copy"),
            ("HISTORY", "history"),
            ("=", "equals"),
        ],
    ]

    for row_index, row in enumerate(rows):

        cols = st.columns(5)

        for col, (
            label,
            action,
        ) in zip(cols, row):

            with col:

                if st.button(
                    label,
                    key=f"button_{row_index}_{label}",
                    use_container_width=True,
                ):

                    if action == "clear":
                        clear_all()

                    elif action == "clear_entry":
                        clear_entry()

                    elif action == "back":
                        backspace()

                    elif action == "sign":
                        toggle_sign()

                    elif action == "equals":
                        calculate()

                    elif action == "mplus":
                        memory_add()

                    elif action == "mminus":
                        memory_subtract()

                    elif action == "mc":
                        memory_clear()

                    elif action == "mr":
                        memory_recall()

                    elif action == "copy":
                        copy_result()

                    elif action == "history":
                        st.session_state.status = (
                            "Verlauf rechts geöffnet"
                        )

                    else:
                        add_text(action)

                    st.rerun()

    st.markdown(
        "</div>",
        unsafe_allow_html=True,
    )


# ============================================================
# HISTORY
# ============================================================

with right:

    st.markdown(
        '<div class="nova-card">'
        '<div class="section-title">'
        'VERLAUF'
        '</div>',
        unsafe_allow_html=True,
    )

    search = st.text_input(
        "🔎",
        placeholder="Verlauf durchsuchen...",
        label_visibility="collapsed",
    )

    filtered_history = [
        item
        for item in st.session_state.history
        if (
            not search
            or search.lower()
            in item["expression"].lower()
            or search.lower()
            in item["result"].lower()
        )
    ]

    if st.button(
        "🗑 Verlauf löschen",
        use_container_width=True,
    ):
        clear_history()
        st.rerun()

    st.markdown(
        f"**{len(st.session_state.history)} "
        f"Berechnungen**"
    )

    if not filtered_history:

        st.caption(
            "Noch keine Berechnungen."
        )

    else:

        for index, item in enumerate(
            filtered_history
        ):

            st.markdown(
                f"""
                <div class="history-card">

                    <div class="history-expression">
                        {item["expression"]}
                    </div>

                    <div class="history-result">
                        = {item["result"]}
                    </div>

                </div>
                """,
                unsafe_allow_html=True,
            )

            if st.button(
                "↩ Laden",
                key=f"load_{index}",
                use_container_width=True,
            ):

                st.session_state.expression = (
                    item["expression"]
                )

                st.session_state.result = ""

                st.rerun()

    st.markdown(
        "</div>",
        unsafe_allow_html=True,
    )


